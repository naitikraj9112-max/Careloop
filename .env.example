# CareLoop Environment Variables Template
# Copy this file to .env and insert your real credentials.

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# EmailJS Service Configuration (Multi-channel notifications & invites)
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here

# DeepSeek AI Voice Companion
VITE_DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here

# Optional: Google Gemini Vision API (for fallback Prescription OCR)
VITE_GEMINI_API_KEY=your_gemini_api_key_here
